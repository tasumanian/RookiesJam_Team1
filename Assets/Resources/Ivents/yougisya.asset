  content:
  - "\u300C\u5BB9\u7591\u8005\u306E\u5019\u88DC\u300D\r\n\u8B66\u5BDF\u306E\u53D6\u308A\u8ABF\u3079\u3067\u308F\u304B\u3063\u3066\u3044\u308B\u3053\u3068\u304C\u3042\u308B\u3088\u3046\u3060\u3002\n\u6BBA\u5BB3\u73FE\u5834\u306F\u300C\u57F7\u52D9\u5BA4\u300D\n\u6BBA\u5BB3\u3055\u308C\u305F\u306E\u306F\u3053\u306E\u300C\u9928\u306E\u4E3B\u4EBA\u300D\u3068\u306E\u3053\u3068\u3060\r\n"
  - "\u30D0\u30B1\u30E2\u30CE\u306B\u6BBA\u3055\u308C\u305F\u3068\u306E\u5642\u3082\u3042\u308B\u304C\n\u5BB9\u7591\u8005\u306F\u4E09\u4EBA\n\u300C\u59BB\u300D\u300C\u606F\u5B50\u300D\u300C\u57F7\u4E8B\u9577\u300D"
